# Gerados automaticamente por "npm run setup". Não compartilhe.
APP_SECRET=
SETUP_TOKEN=

# Servidor. Mantenha 127.0.0.1 no computador local.
HOST=127.0.0.1
PORT=3000
DATA_DIR=data
# Mude para true na VPS, com HTTPS.
COOKIE_SECURE=false

# Shopee: painel de afiliados > Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Claude: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# NVIDIA: build.nvidia.com > API Keys. Usada quando ANTHROPIC_API_KEY está vazia.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# baileys = direto neste computador; evolution = VPS com Docker
WHATSAPP_PROVIDER=baileys
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
